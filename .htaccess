AddDefaultCharset UTF-8
<IfModule mod_headers.c>
    Header set Content-Type "text/html; charset=UTF-8"
</IfModule>

# Prevent caching of HTML files to force clean asset loads
<FilesMatch "\.(html|htm)$">
    <IfModule mod_headers.c>
        Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </IfModule>
</FilesMatch>

RewriteEngine On

# Redirect Cuttify and legacy Cutify variants to the new subdomain
RewriteRule ^/?cuttify/?$ https://cuttify.anvum.com/ [R=301,L,NC]
RewriteRule ^/?cuttify\.html$ https://cuttify.anvum.com/ [R=301,L,NC]
RewriteRule ^/?cuttify-success/?$ https://cuttify.anvum.com/success [R=301,L,NC]
RewriteRule ^/?cuttify-success\.html$ https://cuttify.anvum.com/success [R=301,L,NC]
RewriteRule ^/?cutify/?$ https://cuttify.anvum.com/ [R=301,L,NC]
RewriteRule ^/?cutify\.html$ https://cuttify.anvum.com/ [R=301,L,NC]
RewriteRule ^/?cutify-ar/?$ https://cuttify.anvum.com/ [R=301,L,NC]
RewriteRule ^/?cutify-ar\.html$ https://cuttify.anvum.com/ [R=301,L,NC]

# 1. Redirect standard .html extensions to clean URLs
RewriteCond %{THE_REQUEST} /([^.]+)\.html [NC]
RewriteRule ^ %1 [R=301,L]

# 2. Internally map clean URLs to .html files (if they exist)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.*)$ $1.html [NC,L]

