AddDefaultCharset UTF-8
<IfModule mod_headers.c>
    Header set Content-Type "text/html; charset=UTF-8"
</IfModule>

# Prevent caching of HTML files to force clean asset loads
<FilesMatch "\.(html|htm)$">
    <IfModule mod_headers.c>
        Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </IfModule>
</FilesMatch>

RewriteEngine On

# Redirect legacy Cutify (single t) URLs to Cuttify (double t)
RewriteRule ^/?cutify/?$ https://ahmednazif.com/cuttify [R=301,L,NC]
RewriteRule ^/?cutify\.html$ https://ahmednazif.com/cuttify [R=301,L,NC]
RewriteRule ^/?cutify-ar/?$ https://ahmednazif.com/cuttify [R=301,L,NC]
RewriteRule ^/?cutify-ar\.html$ https://ahmednazif.com/cuttify [R=301,L,NC]

# 1. Redirect /cuttify.html to /cuttify (clean URLs)
RewriteCond %{THE_REQUEST} /([^.]+)\.html [NC]
RewriteRule ^ %1 [R=301,L]

# 2. Internally map /cuttify to /cuttify.html
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.*)$ $1.html [NC,L]

