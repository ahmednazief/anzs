AddDefaultCharset UTF-8
<IfModule mod_headers.c>
    Header set Content-Type "text/html; charset=UTF-8"
</IfModule>

RewriteEngine On

# Redirect legacy Cutify (single t) URLs to Cuttify (double t)
RewriteRule ^cutify$ /cuttify [R=301,L,NC]
RewriteRule ^cutify\.html$ /cuttify [R=301,L,NC]
RewriteRule ^cutify-ar$ /cuttify [R=301,L,NC]
RewriteRule ^cutify-ar\.html$ /cuttify [R=301,L,NC]

# 1. Redirect /cuttify.html to /cuttify (clean URLs)
RewriteCond %{THE_REQUEST} /([^.]+)\.html [NC]
RewriteRule ^ %1 [R=301,L]

# 2. Internally map /cuttify to /cuttify.html
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.*)$ $1.html [NC,L]

